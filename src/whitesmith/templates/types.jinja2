{%- macro write_imports(clients, prefix) -%}

from typing import Literal, overload

from blacksmith import (
{% if async_ %}    AsyncBaseClient,
    AsyncClientFactory,
    AsyncRouteProxy,
{%- endif %}
    HTTPError,
{%- if sync %}
    SyncBaseClient,
    SyncClientFactory,
    SyncRouteProxy,
{%- endif %}
)
{%- for client_name, resources in clients.items() -%}
    {%- for resource_name, resource in resources.items() -%}
{% if safe_type_exists(resource, "collection", "contract", "GET", 1) %}
from {{ resource.collection.contract["GET"][1].__module__ }} import {{ resource.collection.contract["GET"][1].__name__ }}
{%- endif %}
{% if safe_type_exists(resource, "resource", "contract", "GET", 1) %}
from {{ resource.resource.contract["GET"][1].__module__ }} import {{ resource.resource.contract["GET"][1].__name__ }}
{%- endif %}
    {%- endfor %}
{%- endfor %}
{%- endmacro -%}

{%- macro client_class_name(prefix, client_name) -%}
    {{prefix}}{{ client_name|snake_to_pascal }}Client
{%- endmacro -%}

{%- macro route_proxy(resource, prefix) -%}
{{prefix}}RouteProxy[
    {{-
        safe_get_type(resource, "collection", "contract", "GET", 1, "__name__")
    }}, {{
        safe_get_type(resource, "resource", "contract", "GET", 1, "__name__")
    -}}, HTTPError]
{%- endmacro -%}

{%- macro create_client(clients, prefix) -%}
    {%- for client_name, resources in sorted(clients.items()) %}
class {{ client_class_name(prefix, client_name) }}({{prefix}}BaseClient[HTTPError]):
        {%- for resource_name, resource in resources.items() %}
    {{ resource_name }}: {{ route_proxy(resource, prefix) }}
        {% endfor %}
    {% endfor %}
{%- endmacro -%}


{%- macro create_client_factory(clients, prefix, fn_prefix, await_or_empty) -%}
class {{prefix}}AppClientFactory({{prefix}}ClientFactory[Literal["{{ '", "'.join(sorted(clients.keys())) }}"], HTTPError]):
    {%- for client_name in clients %}
    @overload
    {{fn_prefix}}def __call__(self, client_name: Literal["{{client_name}}"]) -> {{ client_class_name(prefix, client_name) }}: ...
    {% endfor %}

    {{fn_prefix}}def __call__(
        self, client_name: Literal["{{ '", "'.join(sorted(clients.keys())) }}"]
    ) -> {{prefix}}BaseClient[HTTPError]:
        return {{ await_or_empty }}super().__call__(client_name)
{%- endmacro -%}

{{ write_imports(clients, prefix) }}

{%- if async_ -%}
{{- "\n\n" -}}
{{ create_client(clients, "Async") }}

{{ create_client_factory(clients, "Async", "async ", "await ") }}
{%- endif -%}

{%- if sync -%}
{{- "\n\n" -}}
{{ create_client(clients, "Sync")}}

{{ create_client_factory(clients, "Sync", "", "") }}
{%- endif -%}
